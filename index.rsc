13:["$","section",null,{"id":"about","className":"section about","aria-label":"About Mahesh","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-number","aria-hidden":"true","children":"07"}],["$","h2",null,{"children":"About me"}],"$undefined"]}],["$","div",null,{"className":"about-content","children":[["$","p",null,{"children":"I’m Mahesh Lambe, a founder, engineer, researcher and angel investor in Palo Alto, California. I build software around a simple conviction: people should retain ownership of their data, their tools and the decisions made on their behalf."}],["$","div",null,{"className":"about-chapters","children":[["$","div",null,{"className":"about-chapter","children":[["$","h3",null,{"children":"Enterprise & public service"}],["$","p",null,{"children":"For more than twenty years, I’ve worked on AI, CRM and cloud platforms for governments and global enterprises, including Microsoft, PIMCO and the NYPD. My public-sector work includes large-scale systems for more than 170 California state departments. That experience shapes my focus on reliability, accountability and freedom from vendor lock-in."}]]}],["$","div",null,{"className":"about-chapter","children":[["$","h3",null,{"children":"Founding & investing"}],["$","p",null,{"children":"I’m the founder and CEO of Unify Dynamics, working across CRM, cloud and generative AI. I’ve founded four startups and, as an angel investor, backed more than 100 companies across AI, automation and enterprise software. Building companies and supporting other founders are both part of my work."}]]}],["$","div",null,{"className":"about-chapter","children":[["$","h3",null,{"children":"Research & security"}],["$","p",null,{"children":["I’m a core contributor to MIT’s Project NANDA, exploring how agents discover one another, establish identity and collaborate across systems. I co-authored the"," ",["$","a",null,{"href":"#research","children":"four NANDA papers collected here"}],", with Ramesh Raskar and collaborators, on agent naming, verified AgentFacts, adaptive resolution and Zero Trust Agentic Access."]}],["$","p",null,{"children":["I’m also a founding member, reviewer and contributor to the"," ",["$","a",null,{"href":"https://aivss.owasp.org/","children":"OWASP AI Vulnerability Scoring System"}],", helping develop shared ways to assess security risks in AI and agentic systems."]}],["$","p",null,{"children":["My upstream proposals to WebMCP address"," ",["$","a",null,{"href":"https://github.com/webmachinelearning/webmcp/pull/275","children":"browser-tool permissions"}]," ","and"," ",["$","a",null,{"href":"https://github.com/webmachinelearning/webmcp/pull/279","children":"clearer tool-execution contracts"}],"."]}]]}],["$","div",null,{"className":"about-chapter","children":[["$","h3",null,{"children":"Platforms & tools"}],["$","p",null,{"children":["My ",["$","a",null,{"href":"#library","children":"public work"}]," spans user-owned AI, CRM and model economics; civic-service guides; agent discovery, privacy and consent; developer tools; and evaluation and assurance. It includes MySovereign.ai, LoveCRM.org, Tokenomy.ai, LegoClaw.com, Plus91, ConnectorBay, Agent Privacy, Personaeval, IsWebMCP, AgentLens, AgentBump, Enterprise Agent Simulation Assurance, OpenWood, MuseTown × MuseSquare, and source-linked directories."]}],["$","p",null,{"children":"Alongside that work, I build private products for personal AI, regional civic services, privacy, agent control, evidence and revenue systems. The common thread is making actions inspectable, permissions revocable and ownership meaningful."}]]}],["$","div",null,{"className":"about-chapter","children":[["$","h3",null,{"children":"Open community"}],["$","p",null,{"children":["Sharing what I learn has long been part of the practice. I was among the"," ","$L32",". Today, that continues through open-source projects,"," ","$L33"," ","on agent registries, AgentFacts and the architecture of an open agentic web."]}]]}]]}]]}]]}]
