lowed to do—and what it did."}],["$","div",null,{"className":"project-detail","children":[["$","span",null,{"children":"Purpose-bound permissions"}],["$","span",null,{"children":"Consent receipts"}],["$","span",null,{"children":"Signed proofs"}]]}],["$","a",null,{"href":"https://github.com/mlmrx/AgentHalo","className":"text-link","children":["Explore AgentHalo ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}]]}],["$","article",null,{"className":"project","children":[["$","div",null,{"className":"project-top","children":["$","span",null,{"className":"eyebrow","children":"Evaluation & evidence"}]}],["$","h3",null,{"children":"Truthseek"}],["$","p",null,{"children":"A convincing answer is only a beginning. Truthseek puts an agent’s claims to the test, through an evaluation harness and a companion that brings that scrutiny into the editor."}],["$","div",null,{"className":"project-links","children":[["$","a",null,{"href":"https://github.com/mlmrx/truthseek-eval-harness","className":"text-link","children":["Evaluation harness ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}],["$","a",null,{"href":"https://github.com/mlmrx/truthseek-vscode","className":"text-link","children":["VS Code companion ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}]]}]]}]]}]]}],["$","section",null,{"id":"book","className":"section work-film","aria-label":"Product screens in motion","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-number","aria-hidden":"true","children":"03"}],["$","h2",null,{"children":"Work in motion"}],["$","p",null,{"children":"A book of real product screens."}]]}],["$","div",null,{"className":"work-film-content","children":[["$","figure",null,{"className":"work-film-figure","children":[["$","picture",null,{"children":"$e"}],["$","figcaption",null,{"children":"Screens from MySovereign.ai, LoveCRM.org, Tokenomy.ai, LegoClaw.c