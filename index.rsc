1:[["$","a",null,{"href":"#main","className":"skip","children":"Skip to content"}],["$","header",null,{"className":"masthead","id":"top","children":[["$","a",null,{"className":"masthead-brand","href":"#top","aria-label":"Mahesh Lambe home","children":"Mahesh Lambe"}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"#work","children":"Work"}],["$","a",null,{"href":"#research","children":"Research"}],["$","a",null,{"href":"#about","children":"About"}],["$","a",null,{"href":"#connect","children":"Contact"}]]}]]}],["$","main",null,{"id":"main","children":[["$","$Ld",null,{}],["$","section",null,{"id":"work","className":"section opening-note","aria-label":"Why I build","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-number","aria-hidden":"true","children":"01"}],["$","h2",null,{"children":"Why I build"}],"$undefined"]}],["$","div",null,{"className":"section-content","children":[["$","p",null,{"children":"After two decades building software for enterprises and public services, I keep returning to one question: what should people be able to see, choose and control?"}],["$","p",null,{"children":"That question guides my work on AI: clear identities, meaningful permissions and evidence for what systems actually do."}]]}]]}],["$","section",null,{"id":"selected","className":"section","aria-label":"Selected work","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-number","aria-hidden":"true","children":"02"}],["$","h2",null,{"children":"Selected work"}],["$","p",null,{"children":"Two explorations in trust and accountability."}]]}],["$","div",null,{"className":"projects","children":[["$","article",null,{"className":"project","children":[["$","div",null,{"className":"project-top","children":["$","span",null,{"className":"eyebrow","children":"Identity & consent"}]}],["$","h3",null,{"children":"AgentHalo"}],["$","p",null,{"children":"Your agent should carry your trust with it. AgentHalo brings identity, memory, permissions and consent together across devices, with a record of what an agent was allowed to do—and what it did."}],["$","div",null,{"className":"project-detail","children":[["$","span",null,{"children":"Purpose-bound permissions"}],["$","span",null,{"children":"Consent receipts"}],["$","span",null,{"children":"Signed proofs"}]]}],["$","a",null,{"href":"https://github.com/mlmrx/AgentHalo","className":"text-link","children":["Explore AgentHalo ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}]]}],["$","article",null,{"className":"project","children":[["$","div",null,{"className":"project-top","children":["$","span",null,{"className":"eyebrow","children":"Evaluation & evidence"}]}],["$","h3",null,{"children":"Truthseek"}],["$","p",null,{"children":"A convincing answer is only a beginning. Truthseek puts an agent’s claims to the test, through an evaluation harness and a companion that brings that scrutiny into the editor."}],["$","div",null,{"className":"project-links","children":[["$","a",null,{"href":"https://github.com/mlmrx/truthseek-eval-harness","className":"text-link","children":["Evaluation harness ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}],["$","a",null,{"href":"https://github.com/mlmrx/truthseek-vscode","className":"text-link","children":["VS Code companion ",["$","span",null,{"aria-hidden":"true","className":"arrow","children":"↗"}]]}]]}]]}]]}]]}],["$","section",null,{"id":"book","className":"section work-film","aria-label":"Product screens in motion","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"section-number","aria-hidden":"true","children":"03"}],["$","h2",null,{"children":"Work in motion"}],["$","p",null,{"children":"A book of real product screens."}]]}],["$","div",null,{"className":"work-film-content","children":[["$","figure",null,{"className":"w